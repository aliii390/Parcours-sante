{{ form_start(medicamentType, {
    'action': path('app_modifier_medicament', {id: medicament.id}),
    'attr': {'class': 'space-y-4'}
}) }}

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
    {{ form_widget(medicamentType.nom, {'attr': {'class': 'w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900'}}) }}
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Dosage</label>
    {{ form_widget(medicamentType.dosage, {'attr': {'class': 'w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900'}}) }}
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Début</label>
      {{ form_widget(medicamentType.date_debut, {'attr': {'class': 'w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900'}}) }}
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Fin</label>
      {{ form_widget(medicamentType.date_fin, {'attr': {'class': 'w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900'}}) }}
    </div>
  </div>

  <!-- ===== PRISES QUOTIDIENNES ===== -->
  <div class="pt-4 border-t border-gray-100">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Prises quotidiennes</h3>

    <div id="prises-container"
         data-index="{{ medicamentType.priseMedicaments|length }}"
         data-prototype="{{ form_widget(medicamentType.priseMedicaments.vars.prototype)|e('html_attr') }}"
         class="space-y-3">

      {% for prise in medicamentType.priseMedicaments %}
        <div class="prise-item flex items-end gap-3 p-3 bg-slate-50 rounded-xl border border-gray-100">
          <div class="flex-1 grid grid-cols-2 gap-3 prise-fields">
            <div>
              {{ form_label(prise.heurePrevue, 'Heure', {'label_attr': {'class': 'block text-xs font-semibold text-gray-700 mb-1.5'}}) }}
              {{ form_widget(prise.heurePrevue, {'attr': {'class': 'w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900'}}) }}
            </div>
            <div>
              {{ form_label(prise.nombresComprimes, 'Comprimés', {'label_attr': {'class': 'block text-xs font-semibold text-gray-700 mb-1.5'}}) }}
              {{ form_widget(prise.nombresComprimes, {'attr': {'class': 'w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-900'}}) }}
            </div>
          </div>
          <button type="button" class="btn-remove-prise flex-shrink-0 w-10 h-10 flex items-center justify-center text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-colors" aria-label="Supprimer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      {% endfor %}
    </div>

    <button type="button" id="add-prise" class="mt-3 w-full border-2 border-dashed border-gray-200 hover:border-gray-300 text-gray-500 hover:text-gray-700 text-sm font-medium py-2.5 rounded-xl transition-colors inline-flex items-center justify-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Ajouter une prise
    </button>
  </div>

  <div class="flex gap-3 pt-2">
    <button type="button" onclick="fermerModal()" class="flex-1 py-2.5 border border-gray-200 rounded-lg text-gray-700 hover:border-gray-300 transition-colors">Annuler</button>
    <button type="submit" class="flex-1 py-2.5 bg-gray-900 text-white rounded-lg hover:bg-gray-800 font-semibold transition-colors">Enregistrer</button>
  </div>

{{ form_end(medicamentType) }}